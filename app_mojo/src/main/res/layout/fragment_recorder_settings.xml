<?xml version="1.0" encoding="utf-8"?>
<!-- RaufixTeam Launcher V1 — Recording Settings (RFX-181–182, RFX-195). No floating bubble. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zyrox_bg_base">

    <LinearLayout
        android:id="@+id/recorder_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:orientation="vertical"
        android:background="@drawable/bg_zyrox_glass_card"
        android:padding="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recording Settings"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Resolution preset (RFX-186, RFX-187) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resolution"
            android:textColor="@color/zyrox_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/recorder_resolution"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_zyrox_input"/>

        <!-- Audio mode — exactly four (RFX-189–192) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio Mode"
            android:textColor="@color/zyrox_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/recorder_audio_mode"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_zyrox_input"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/recorder_start"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Start"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/recorder_pause"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Pause"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/recorder_resume"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Resume"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/recorder_stop"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Stop"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/zyrox_divider"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/recorder_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Idle"
            android:textColor="@color/zyrox_text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/recorder_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frames: 0  Dropped: 0"
            android:textColor="@color/zyrox_text_muted"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Note: transport controls also reachable via the required foreground-service notification. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No floating record bubble — controls in this menu and the system notification only."
        android:textColor="@color/zyrox_text_muted"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/recorder_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
